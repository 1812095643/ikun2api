# Copy to /etc/ikun-ops-monitor/monitor.env, owner root:ops-monitor, mode 0640.
# Inject real values locally. Never paste secrets into chat or commit this file with secrets.
OPS_SITE_ID=ikun2api
# Must match gateway timezone/TZ; business default is Asia/Shanghai.
OPS_BUSINESS_TIMEZONE=Asia/Shanghai
OPS_OBSERVATION_TOKEN=
OPS_POSTGRES_DSN=
OPS_GATEWAY_HEALTH_URL=http://127.0.0.1:8080/health
OPS_REDIS_ADDRESS=127.0.0.1:16379
OPS_REDIS_PASSWORD=
OPS_CERTIFICATE_FILE=
OPS_FEISHU_APP_ID=
OPS_FEISHU_APP_SECRET=
OPS_SMTP_ADDRESS=
OPS_SMTP_USERNAME=
OPS_SMTP_PASSWORD=
OPS_SMTP_FROM=
OPS_SMTP_IMPLICIT_TLS=true
# Recipients/thresholds/shadow/ownership are configured in the authenticated Ops UI,
# not duplicated here. This file contains transport secrets only.
