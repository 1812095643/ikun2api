{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IKUN Bridge",
  "version": "0.2.6",
  "identifier": "com.ikun.bridge.desktop",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [{ "label": "main", "title": "IKUN Bridge", "width": 640, "height": 510, "minWidth": 460, "minHeight": 440 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "icon": ["../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png", "../src-tauri/icons/icon.ico", "../src-tauri/icons/icon.icns"]
  }
}
